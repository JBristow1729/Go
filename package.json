{
  "name": "go-wholegrain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "format": "prettier --write src tests scripts netlify/functions public/go.css package.json"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4"
  },
  "packageManager": "pnpm@11.19.0"
}
